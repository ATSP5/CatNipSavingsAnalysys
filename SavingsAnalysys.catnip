          "reportDefinition": "",
          "dataSchema": "",
          "interactiveReport": "{\u0022ClassName\u0022:\u0022SavingsSimulatorPage\u0022,\u0022Title\u0022:\u0022Kiedy uzbieram cel? \\u2014 symulacja oszcz\\u0119dzania\u0022,\u0022Inputs\u0022:[\u0022analyzer\u0022],\u0022Height\u0022:1750,\u0022KeepAlive\u0022:true,\u0022Markup\u0022:\u0022\\u003Cdiv class=\\u0022sv\\u0022\\u003E\\n  \\u003Ch1\\u003EKiedy uzbieram {pln(target)} z\\u0142{\\u0022 dzisiejszych\\u0022 if target_mode == \\u0022today\\u0022 else \\u0022\\u0022}?\\u003C/h1\\u003E\\n  \\u003Cp class=\\u0022cn-muted\\u0022\\u003EStart: \\u003Cb\\u003E{pln(start_capital)} z\\u0142\\u003C/b\\u003E z historii wp\\u0142at ({history_source}), potem co miesi\\u0105c wybrana wp\\u0142ata.\\n  Parametry bazowe to stan na dzi\\u015B ({as_of}): inflacja z GUS, stopa referencyjna i cena z\\u0142ota z NBP pobierane przy uruchomieniu,\\n  oferty kont i obligacji spisane 13.10.2026. Ka\\u017Cda warto\\u015B\\u0107 jest kwot\\u0105 \\u003Cb\\u003Ena r\\u0119k\\u0119\\u003C/b\\u003E \\u2014 po podatku Belki (19%), op\\u0142atach za wcze\\u015Bniejszy wykup i kosztach sprzeda\\u017Cy.\\u003C/p\\u003E\\n  \\u003Cdiv class=\\u0022cn-row\\u0022\\u003E{button(\\u0022Przywr\\u00F3\\u0107 parametry z dzi\\u015B\\u0022, call=\\u0022reset\\u0022, kind=\\u0022secondary\\u0022)}\\u003C/div\\u003E\\n\\n  \\u003Cdiv class=\\u0022cn-grid-4\\u0022\\u003E\\n    \\u003Cdiv\\u003E{kpi(\\u0022Najszybciej (wybrana wp\\u0142ata)\\u0022, r.fastest_date)}\\u003Cdiv class=\\u0022kpi-sub\\u0022\\u003E{r.fastest_label}\\u003C/div\\u003E\\u003C/div\\u003E\\n    \\u003Cdiv\\u003E{kpi(\\u0022Inflacja CPI\\u0022, r.kpis[\\u0022cpi\\u0022])}\\u003Cdiv class=\\u0022kpi-sub\\u0022\\u003E{r.kpis[\\u0022cpi_label\\u0022]} \\u00B7 \\u015Brednio 10 lat {r.kpis[\\u0022cpi10\\u0022]}\\u003C/div\\u003E\\u003C/div\\u003E\\n    \\u003Cdiv\\u003E{kpi(\\u0022Stopa referencyjna NBP\\u0022, r.kpis[\\u0022ref\\u0022])}\\u003Cdiv class=\\u0022kpi-sub\\u0022\\u003E{r.kpis[\\u0022ref_label\\u0022]}\\u003C/div\\u003E\\u003C/div\\u003E\\n    \\u003Cdiv\\u003E{kpi(\\u0022Z\\u0142oto\\u0022, r.kpis[\\u0022gold\\u0022])}\\u003Cdiv class=\\u0022kpi-sub\\u0022\\u003E{r.kpis[\\u0022gold_label\\u0022]}\\u003C/div\\u003E\\u003C/div\\u003E\\n  \\u003C/div\\u003E\\n\\n  \\u003Ch2\\u003ECel w dzisiejszych i przysz\\u0142ych z\\u0142otych\\u003C/h2\\u003E\\n  \\u003Cp class=\\u0022small cn-muted\\u0022\\u003E{target_mode_text} Daty dla wybranej wp\\u0142aty; najwolniej = ostatni instrument z rankingu, kt\\u00F3ry osi\\u0105ga cel w horyzoncie{missing_text}.\\u003C/p\\u003E\\n  \\u003Cdiv class=\\u0022cn-grid-2\\u0022\\u003E\\n    \\u003Cdiv class=\\u0022cn-card\\u0022\\u003E\\n      \\u003Ch3\\u003ENajszybciej: {tv[\\u0022fastest\\u0022][\\u0022date\\u0022]} \\u003Cspan class=\\u0022cn-muted small\\u0022\\u003E({tv[\\u0022fastest\\u0022][\\u0022duration\\u0022]})\\u003C/span\\u003E\\u003C/h3\\u003E\\n      \\u003Cdiv class=\\u0022small cn-muted\\u0022\\u003E{tv[\\u0022fastest\\u0022][\\u0022instrument\\u0022]}\\u003C/div\\u003E\\n      \\u003Cdiv class=\\u0022cn-grid-2\\u0022\\u003E\\n        \\u003Cdiv\\u003E{kpi(\\u0022Cel w dzisiejszych z\\u0142\\u0022, tv[\\u0022fastest\\u0022][\\u0022today\\u0022])}\\u003C/div\\u003E\\n        \\u003Cdiv\\u003E{kpi(\\u0022Cel w dniu uzbierania\\u0022, tv[\\u0022fastest\\u0022][\\u0022nominal\\u0022])}\\u003C/div\\u003E\\n      \\u003C/div\\u003E\\n      \\u003Cdiv class=\\u0022kpi-sub\\u0022\\u003EWzrost cen do tego dnia: {tv[\\u0022fastest\\u0022][\\u0022prices\\u0022]}\\u003C/div\\u003E\\n    \\u003C/div\\u003E\\n    \\u003Cdiv class=\\u0022cn-card\\u0022\\u003E\\n      \\u003Ch3\\u003ENajwolniej: {tv[\\u0022slowest\\u0022][\\u0022date\\u0022]} \\u003Cspan class=\\u0022cn-muted small\\u0022\\u003E({tv[\\u0022slowest\\u0022][\\u0022duration\\u0022]})\\u003C/span\\u003E\\u003C/h3\\u003E\\n      \\u003Cdiv class=\\u0022small cn-muted\\u0022\\u003E{tv[\\u0022slowest\\u0022][\\u0022instrument\\u0022]}\\u003C/div\\u003E\\n      \\u003Cdiv class=\\u0022cn-grid-2\\u0022\\u003E\\n        \\u003Cdiv\\u003E{kpi(\\u0022Cel w dzisiejszych z\\u0142\\u0022, tv[\\u0022slowest\\u0022][\\u0022today\\u0022])}\\u003C/div\\u003E\\n        \\u003Cdiv\\u003E{kpi(\\u0022Cel w dniu uzbierania\\u0022, tv[\\u0022slowest\\u0022][\\u0022nominal\\u0022])}\\u003C/div\\u003E\\n      \\u003C/div\\u003E\\n      \\u003Cdiv class=\\u0022kpi-sub\\u0022\\u003EWzrost cen do tego dnia: {tv[\\u0022slowest\\u0022][\\u0022prices\\u0022]}\\u003C/div\\u003E\\n    \\u003C/div\\u003E\\n  \\u003C/div\\u003E\\n\\n  \\u003Cdiv class=\\u0022cn-grid-3\\u0022\\u003E\\n    \\u003Cdiv class=\\u0022cn-card\\u0022\\u003E\\n      \\u003Ch3\\u003EPlan oszcz\\u0119dzania\\u003C/h3\\u003E\\n      {slider(\\u0022contribution\\u0022, 3000, 5000, step=50, label=\\u0022Wp\\u0142ata miesi\\u0119czna [z\\u0142]\\u0022, format=\\u0022,.0f\\u0022)}\\n      {slider(\\u0022target\\u0022, 50000, 2000000, step=10000, label=\\u0022Cel [z\\u0142]\\u0022, format=\\u0022,.0f\\u0022)}\\n      {radio(\\u0022target_mode\\u0022, [(\\u0022future\\u0022, \\u0022Warto\\u015B\\u0107 przysz\\u0142a \\u2014 tyle z\\u0142 nominalnie w dniu uzbierania\\u0022), (\\u0022today\\u0022, \\u0022Warto\\u015B\\u0107 dzisiejsza \\u2014 si\\u0142a nabywcza dzisiejszych z\\u0142 (ro\\u015Bnie z inflacj\\u0105)\\u0022)], label=\\u0022Cel podany jako\\u0022)}\\n      {number(\\u0022start_capital\\u0022, min=0, step=1000, label=\\u0022Kapita\\u0142 startowy [z\\u0142] (suma historii)\\u0022)}\\n      {slider(\\u0022horizon_years\\u0022, 5, 30, step=1, label=\\u0022Horyzont symulacji [lata]\\u0022, format=\\u0022.0f\\u0022)}\\n      {toggle(\\u0022index_contributions\\u0022, \\u0022Wp\\u0142aty rosn\\u0105 z inflacj\\u0105\\u0022)}\\n    \\u003C/div\\u003E\\n    \\u003Cdiv class=\\u0022cn-card\\u0022\\u003E\\n      \\u003Ch3\\u003EInflacja i stopy procentowe\\u003C/h3\\u003E\\n      {slider(\\u0022cpi_start\\u0022, -1, 12, step=0.1, label=\\u0022Inflacja dzi\\u015B [% r/r] (GUS)\\u0022, format=\\u0022.1f\\u0022)}\\n      {slider(\\u0022cpi_long\\u0022, -1, 12, step=0.1, label=\\u0022Inflacja docelowa [% r/r]\\u0022, format=\\u0022.1f\\u0022)}\\n      {slider(\\u0022cpi_months\\u0022, 0, 60, step=1, label=\\u0022Doj\\u015Bcie do docelowej [mies.]\\u0022, format=\\u0022.0f\\u0022)}\\n      {slider(\\u0022ref_end\\u0022, 0, 10, step=0.25, label=\\u0022Stopa NBP docelowa [%] (ROR, DOR, konta)\\u0022, format=\\u0022.2f\\u0022)}\\n      {slider(\\u0022ref_months\\u0022, 0, 36, step=1, label=\\u0022Doj\\u015Bcie stopy NBP [mies.]\\u0022, format=\\u0022.0f\\u0022)}\\n      \\u003Cp class=\\u0022small cn-muted\\u0022\\u003EInflacja indeksuje COI, EDO, ROS, ROD i wyznacza warto\\u015B\\u0107 \\u201Ew dzisiejszych z\\u0142\\u201D. Do ko\\u0144ca horyzontu ceny wzrosn\\u0105 {r.kpis[\\u0022prices\\u0022]}.\\u003C/p\\u003E\\n    \\u003C/div\\u003E\\n    \\u003Cdiv class=\\u0022cn-card\\u0022\\u003E\\n      \\u003Ch3\\u003EInstrumenty\\u003C/h3\\u003E\\n      {slider(\\u0022erste_rate\\u0022, 0, 8, step=0.05, label=\\u0022Erste Konto Pro: oprocentowanie [%]\\u0022, format=\\u0022.2f\\u0022)}\\n      {number(\\u0022erste_limit\\u0022, min=0, step=10000, label=\\u0022Erste: limit kwoty z t\\u0105 stawk\\u0105 [z\\u0142]\\u0022)}\\n      {slider(\\u0022erste_std\\u0022, 0, 5, step=0.05, label=\\u0022Erste: ponad limit [%]\\u0022, format=\\u0022.2f\\u0022)}\\n      {toggle(\\u0022repeat_promo\\u0022, \\u0022Promocje bank\\u00F3w odnawiane (przenosz\\u0119 \\u015Brodki)\\u0022)}\\n      {slider(\\u0022gold_return\\u0022, -5, 15, step=0.1, label=\\u0022Z\\u0142oto: oczekiwany wzrost ceny [%/rok]\\u0022, format=\\u0022.1f\\u0022)}\\n      {slider(\\u0022gold_vol\\u0022, 0, 40, step=0.5, label=\\u0022Z\\u0142oto: zmienno\\u015B\\u0107 [%/rok]\\u0022, format=\\u0022.1f\\u0022)}\\n      {slider(\\u0022gold_premium\\u0022, 0, 10, step=0.1, label=\\u0022Z\\u0142oto: mar\\u017Ca przy zakupie [%]\\u0022, format=\\u0022.1f\\u0022)}\\n      {slider(\\u0022gold_discount\\u0022, 0, 10, step=0.1, label=\\u0022Z\\u0142oto: dyskonto skupu [%]\\u0022, format=\\u0022.1f\\u0022)}\\n      {slider(\\u0022fund_return\\u0022, 0, 10, step=0.1, label=\\u0022Fundusz obligacji: zwrot po op\\u0142atach [%/rok]\\u0022, format=\\u0022.1f\\u0022)}\\n      {slider(\\u0022etf_return\\u0022, -2, 15, step=0.1, label=\\u0022ETF akcyjny: oczekiwany zwrot [%/rok]\\u0022, format=\\u0022.1f\\u0022)}\\n      {slider(\\u0022etf_vol\\u0022, 0, 40, step=0.5, label=\\u0022ETF akcyjny: zmienno\\u015B\\u0107 [%/rok]\\u0022, format=\\u0022.1f\\u0022)}\\n      {toggle(\\u0022include_family\\u0022, \\u0022Poka\\u017C obligacje rodzinne ROS/ROD (tylko 800\\u002B)\\u0022)}\\n    \\u003C/div\\u003E\\n  \\u003C/div\\u003E\\n\\n  \\u003Ch2\\u003ERanking: kiedy cel b\\u0119dzie na koncie\\u003C/h2\\u003E\\n  \\u003Cp class=\\u0022small cn-muted\\u0022\\u003EKolejno\\u015B\\u0107 wed\\u0142ug wybranej wp\\u0142aty. Dla z\\u0142ota, funduszu i ETF czas liczony przy oczekiwanym zwrocie, obok mediana i zakres 10\\u201390% z {mc_paths} symulacji Monte Carlo; \\u201ESzansa w horyzoncie\\u201D \\u2014 odsetek symulacji, w kt\\u00F3rych cel pad\\u0142 przed ko\\u0144cem horyzontu.\\u003C/p\\u003E\\n  {table(r.ranking, page_size=20, id=\\u0022ranking\\u0022, filter=False)}\\n\\n  \\u003Ch2\\u003EWarto\\u015B\\u0107 netto w czasie\\u003C/h2\\u003E\\n  \\u003Cdiv class=\\u0022cn-row\\u0022\\u003E{toggle(\\u0022chart_real\\u0022, \\u0022Poka\\u017C w dzisiejszych z\\u0142otych\\u0022)}\\u003C/div\\u003E\\n  {plotly(main_fig, height=460, id=\\u0022main\\u0022)}\\n\\n  \\u003Cdiv class=\\u0022cn-grid-2\\u0022\\u003E\\n    \\u003Cdiv\\u003E\\n      \\u003Ch2\\u003ERozrzut wynik\\u00F3w \\u2014 Monte Carlo\\u003C/h2\\u003E\\n      {select(\\u0022fan_key\\u0022, [(\\u0022etf\\u0022, \\u0022ETF akcyjny\\u0022), (\\u0022gold\\u0022, \\u0022Z\\u0142oto\\u0022), (\\u0022fund\\u0022, \\u0022Fundusz obligacji\\u0022)], label=\\u0022Instrument\\u0022)}\\n      {plotly(fan_fig, height=380, id=\\u0022fan\\u0022)}\\n    \\u003C/div\\u003E\\n    \\u003Cdiv\\u003E\\n      \\u003Ch2\\u003EInflacja GUS i za\\u0142o\\u017Cenie\\u003C/h2\\u003E\\n      {chart(\\u0022line\\u0022, r.cpi, x=\\u0022Miesi\\u0105c\\u0022, y=[\\u0022Inflacja GUS [%]\\u0022, \\u0022Za\\u0142o\\u017Cenie [%]\\u0022], height=380, mode=\\u0022lines\\u0022, id=\\u0022cpi\\u0022, y_title=\\u0022% r/r\\u0022)}\\n    \\u003C/div\\u003E\\n  \\u003C/div\\u003E\\n\\n  \\u003Ch2\\u003EWszystkie oferty kont oszcz\\u0119dno\\u015Bciowych\\u003C/h2\\u003E\\n  \\u003Cp class=\\u0022small cn-muted\\u0022\\u003E\\u201ENajlepszy bank\\u201D w rankingu to najszybsza z tych ofert poza Erste. Promocje dla nowych klient\\u00F3w trwaj\\u0105 zwykle ~3 miesi\\u0105ce, potem stawka standardowa (gdy bank jej nie podaje \\u2014 \\u015Brednia rynkowa 0,86%).\\u003C/p\\u003E\\n  {table(r.offers, page_size=12, id=\\u0022offers\\u0022, filter=False)}\\n\\n  \\u003Cdiv class=\\u0022cn-grid-2\\u0022\\u003E\\n    \\u003Cdiv\\u003E\\n      \\u003Ch2\\u003EObligacje skarbowe \\u2014 oferta na dzi\\u015B\\u003C/h2\\u003E\\n      {table(bond_rows, page_size=10, id=\\u0022bonds\\u0022, filter=False, sortable=False)}\\n    \\u003C/div\\u003E\\n    \\u003Cdiv\\u003E\\n      \\u003Ch2\\u003ETwoja historia wp\\u0142at\\u003C/h2\\u003E\\n      {table(history_rows, page_size=10, id=\\u0022history\\u0022, filter=False, sortable=False)}\\n    \\u003C/div\\u003E\\n  \\u003C/div\\u003E\\n\\n  \\u003Ch2\\u003EZa\\u0142o\\u017Cenia\\u003C/h2\\u003E\\n  \\u003Cul class=\\u0022small\\u0022\\u003E{!notes_html}\\u003C/ul\\u003E\\n  \\u003Ch2\\u003E\\u0179r\\u00F3d\\u0142a\\u003C/h2\\u003E\\n  \\u003Cul class=\\u0022small\\u0022\\u003E{!sources_html}\\u003C/ul\\u003E\\n\\u003C/div\\u003E\\n\u0022,\u0022Code\u0022:\u0022import html as html_lib\\n\\nSERIES_COLORS = [\\u0022#1f6feb\\u0022, \\u0022#8250df\\u0022, \\u0022#57606a\\u0022, \\u0022#8c959f\\u0022, \\u0022#0969da\\u0022, \\u0022#bf8700\\u0022, \\u0022#1a7f37\\u0022, \\u0022#116329\\u0022, \\u0022#d4a72c\\u0022, \\u0022#cf222e\\u0022, \\u0022#fb8500\\u0022]\\n\\n\\ndef setup(self):\\n    self.state.update(self.analyzer.defaults())\\n\\n\\ndef reset(self):\\n    self.state.update(self.analyzer.defaults())\\n    self.refresh()\\n\\n\\ndef prepare(self):\\n    values = self.values()\\n    result = self.analyzer.evaluate(values)\\n    market = self.analyzer.market\\n    return {\\n        \\u0022r\\u0022: result,\\n        \\u0022tv\\u0022: result.target_view,\\n        \\u0022target_mode_text\\u0022: self.target_mode_text(result.target_view),\\n        \\u0022missing_text\\u0022: self.missing_text(result.target_view),\\n        \\u0022pln\\u0022: self.analyzer.pln,\\n        \\u0022as_of\\u0022: market.as_of,\\n        \\u0022mc_paths\\u0022: self.analyzer.settings.mc_paths,\\n        \\u0022history_source\\u0022: self.analyzer.history.source,\\n        \\u0022main_fig\\u0022: self.main_figure(result, values),\\n        \\u0022fan_fig\\u0022: self.fan_figure(result, values),\\n        \\u0022bond_rows\\u0022: self.bond_rows(),\\n        \\u0022history_rows\\u0022: self.analyzer.history.rows(),\\n        \\u0022notes_html\\u0022: \\u0022\\u0022.join(\\u0022\\u003Cli\\u003E%s\\u003C/li\\u003E\\u0022 % html_lib.escape(n) for n in result.notes \\u002B self.assumption_notes()),\\n        \\u0022sources_html\\u0022: \\u0022\\u0022.join(\\u0027\\u003Cli\\u003E\\u003Ca href=\\u0022%s\\u0022\\u003E%s\\u003C/a\\u003E\\u003C/li\\u003E\\u0027 % (html_lib.escape(url), html_lib.escape(name))\\n                                for name, url in market.sources),\\n    }\\n\\n\\ndef target_mode_text(self, view):\\n    if view[\\u0022today_mode\\u0022]:\\n        return (\\u0022Cel to %s z\\u0142 w dzisiejszych pieni\\u0105dzach: dzi\\u015B tyle, a w dniu uzbierania nominalnie wi\\u0119cej \\u0022\\n                \\u0022o wzrost cen.\\u0022 % view[\\u0022target\\u0022])\\n    return (\\u0022Cel to %s z\\u0142 nominalnie w dniu uzbierania: w dzisiejszych pieni\\u0105dzach to mniej o wzrost cen \\u0022\\n            \\u0022do tego dnia.\\u0022 % view[\\u0022target\\u0022])\\n\\n\\ndef missing_text(self, view):\\n    return \\u0022 (%d nie osi\\u0105ga go wcale)\\u0022 % view[\\u0022missing\\u0022] if view[\\u0022missing\\u0022] else \\u0022\\u0022\\n\\n\\ndef main_figure(self, result, values):\\n    traces = []\\n    months = [row[\\u0022Miesi\\u0105c\\u0022] for row in result.chart]\\n    for i, name in enumerate(result.chart_series):\\n        line = {\\u0022width\\u0022: 2, \\u0022color\\u0022: self.SERIES_COLORS[i % len(self.SERIES_COLORS)]}\\n        if name == \\u0022Cel\\u0022:\\n            line = {\\u0022width\\u0022: 2, \\u0022color\\u0022: \\u0022#24292f\\u0022, \\u0022dash\\u0022: \\u0022dash\\u0022}\\n        traces.append({\\u0022type\\u0022: \\u0022scatter\\u0022, \\u0022mode\\u0022: \\u0022lines\\u0022, \\u0022name\\u0022: name, \\u0022x\\u0022: months,\\n                       \\u0022y\\u0022: [row.get(name) for row in result.chart], \\u0022line\\u0022: line,\\n                       \\u0022hovertemplate\\u0022: \\u0022%{y:,.0f} z\\u0142\\u0022})\\n    unit = \\u0022z\\u0142 dzisiejsze\\u0022 if values.get(\\u0022chart_real\\u0022) else \\u0022z\\u0142\\u0022\\n    return {\\u0022data\\u0022: traces, \\u0022layout\\u0022: {\\n        \\u0022margin\\u0022: {\\u0022l\\u0022: 70, \\u0022r\\u0022: 20, \\u0022t\\u0022: 10, \\u0022b\\u0022: 40}, \\u0022hovermode\\u0022: \\u0022x unified\\u0022,\\n        \\u0022yaxis\\u0022: {\\u0022title\\u0022: {\\u0022text\\u0022: unit}, \\u0022tickformat\\u0022: \\u0022,.0f\\u0022},\\n        \\u0022legend\\u0022: {\\u0022orientation\\u0022: \\u0022h\\u0022, \\u0022y\\u0022: -0.15},\\n        \\u0022paper_bgcolor\\u0022: \\u0022rgba(0,0,0,0)\\u0022, \\u0022plot_bgcolor\\u0022: \\u0022rgba(0,0,0,0)\\u0022}}\\n\\n\\ndef fan_figure(self, result, values):\\n    rows = result.fan\\n    x = [row[\\u0022Miesi\\u0105c\\u0022] for row in rows]\\n    band = \\u0022rgba(31,111,235,0.18)\\u0022\\n    data = [\\n        {\\u0022type\\u0022: \\u0022scatter\\u0022, \\u0022mode\\u0022: \\u0022lines\\u0022, \\u0022x\\u0022: x, \\u0022y\\u0022: [r[\\u0022p90 (optymistycznie)\\u0022] for r in rows],\\n         \\u0022name\\u0022: \\u0022p90 (optymistycznie)\\u0022, \\u0022line\\u0022: {\\u0022width\\u0022: 0}, \\u0022hoverinfo\\u0022: \\u0022skip\\u0022},\\n        {\\u0022type\\u0022: \\u0022scatter\\u0022, \\u0022mode\\u0022: \\u0022lines\\u0022, \\u0022x\\u0022: x, \\u0022y\\u0022: [r[\\u0022p10 (pesymistycznie)\\u0022] for r in rows],\\n         \\u0022name\\u0022: \\u002210\\u201390% wynik\\u00F3w\\u0022, \\u0022fill\\u0022: \\u0022tonexty\\u0022, \\u0022fillcolor\\u0022: band, \\u0022line\\u0022: {\\u0022width\\u0022: 0}},\\n        {\\u0022type\\u0022: \\u0022scatter\\u0022, \\u0022mode\\u0022: \\u0022lines\\u0022, \\u0022x\\u0022: x, \\u0022y\\u0022: [r[\\u0022mediana\\u0022] for r in rows], \\u0022name\\u0022: \\u0022mediana\\u0022,\\n         \\u0022line\\u0022: {\\u0022color\\u0022: \\u0022#1f6feb\\u0022, \\u0022width\\u0022: 2}},\\n        {\\u0022type\\u0022: \\u0022scatter\\u0022, \\u0022mode\\u0022: \\u0022lines\\u0022, \\u0022x\\u0022: x, \\u0022y\\u0022: [r[\\u0022Cel\\u0022] for r in rows], \\u0022name\\u0022: \\u0022Cel\\u0022,\\n         \\u0022line\\u0022: {\\u0022color\\u0022: \\u0022#24292f\\u0022, \\u0022dash\\u0022: \\u0022dash\\u0022, \\u0022width\\u0022: 2}},\\n    ]\\n    return {\\u0022data\\u0022: data, \\u0022layout\\u0022: {\\n        \\u0022margin\\u0022: {\\u0022l\\u0022: 70, \\u0022r\\u0022: 20, \\u0022t\\u0022: 10, \\u0022b\\u0022: 40}, \\u0022hovermode\\u0022: \\u0022x unified\\u0022,\\n        \\u0022yaxis\\u0022: {\\u0022title\\u0022: {\\u0022text\\u0022: \\u0022z\\u0142\\u0022}, \\u0022tickformat\\u0022: \\u0022,.0f\\u0022}, \\u0022legend\\u0022: {\\u0022orientation\\u0022: \\u0022h\\u0022, \\u0022y\\u0022: -0.2},\\n        \\u0022paper_bgcolor\\u0022: \\u0022rgba(0,0,0,0)\\u0022, \\u0022plot_bgcolor\\u0022: \\u0022rgba(0,0,0,0)\\u0022}}\\n\\n\\ndef bond_rows(self):\\n    kinds = {\\u0022monthly_ref\\u0022: \\u0022odsetki co miesi\\u0105c, potem stopa NBP \\u002B mar\\u017Ca\\u0022,\\n             \\u0022fixed_capitalized\\u0022: \\u0022sta\\u0142e, kapitalizacja roczna\\u0022,\\n             \\u0022cpi_yearly_coupon\\u0022: \\u0022potem inflacja \\u002B mar\\u017Ca, odsetki co rok\\u0022,\\n             \\u0022cpi_capitalized\\u0022: \\u0022potem inflacja \\u002B mar\\u017Ca, kapitalizacja roczna\\u0022}\\n    return [{\\u0022Seria\\u0022: b.code, \\u0022Okres\\u0022: b.name, \\u00221. okres [%]\\u0022: b.first_rate_pct, \\u0022Mar\\u017Ca [pp]\\u0022: b.margin_pct,\\n             \\u0022Odsetki\\u0022: kinds[b.kind], \\u0022Op\\u0142ata za wcze\\u015Bniejszy wykup [z\\u0142/100 z\\u0142]\\u0022: b.early_fee_pln\\n             if b.code != \\u0022OTS\\u0022 else \\u0022utrata odsetek\\u0022} for b in self.analyzer.market.bonds]\\n\\n\\ndef assumption_notes(self):\\n    gold = self.analyzer.market.gold_history\\n    return [\\n        \\u0022Obligacje: co miesi\\u0105c kupowana nowa seria; odsetki wyp\\u0142acane (ROR, DOR, COI) i wykupione serie s\\u0105 \\u0022\\n        \\u0022reinwestowane po Belce w t\\u0119 sam\\u0105 obligacj\\u0119. Inflacja dla okresu odsetkowego = odczyt GUS sprzed 2 miesi\\u0119cy.\\u0022,\\n        \\u0022Z\\u0142oto: cena NBP %s z\\u0142/g; domy\\u015Blny wzrost %.1f%%/rok to \\u015Brednia z notowa\\u0144 NBP od %s \\u2014 to historia, nie \\u0022\\n        \\u0022prognoza. Sprzeda\\u017C po p\\u00F3\\u0142 roku od ko\\u0144ca miesi\\u0105ca zakupu jest bez podatku.\\u0022 % (\\n            gold.latest_per_gram, gold.cagr * 100, gold.days[0]),\\n        \\u0022Fundusz i ETF: podatek Belki od \\u0142\\u0105cznego zysku przy sprzeda\\u017Cy (odroczony \\u2014 procent sk\\u0142adany od ca\\u0142ej kwoty).\\u0022,\\n        \\u0022Konta: kapitalizacja miesi\\u0119czna, Belka od ka\\u017Cdej kapitalizacji; stawki przesuwaj\\u0105 si\\u0119 razem ze stop\\u0105 NBP.\\u0022,\\n        \\u0022IKE (limit 28 260 z\\u0142 w 2026 r.) zwalnia z Belki tylko przy wyp\\u0142acie po 60. roku \\u017Cycia \\u2014 przy celu na \\u0022\\n        \\u0022kilka lat nie pomaga, dlatego nie jest liczone osobno.\\u0022,\\n    ]\\n\u0022,\u0022Style\u0022:\u0022.sv h1 { margin-bottom: 4px; }\\n.sv h2 { margin-top: 26px; }\\n.sv .small { font-size: 12px; }\\n.sv .kpi-sub { font-size: 12px; color: var(--cn-muted, #6e7781); margin-top: 4px; }\\n.sv .cn-card h3 { margin-top: 0; }\\n\u0022,\u0022SampleData\u0022:\u0022\u0022,\u0022Actions\u0022:[]}",
